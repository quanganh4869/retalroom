# RentFlow Backend Environment Configuration

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentflow_db
DB_USER=postgres
DB_PASSWORD=postgres_local_secret

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
