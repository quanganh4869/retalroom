# Application Configuration
APP_NAME=RentFlow Backend
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Server Networking
HOST=0.0.0.0
PORT=8000

# Security (Change this in production)
SECRET_KEY=dev_insecure_secret_key_change_me_in_production_min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# For local host development: postgresql+asyncpg://postgres:postgres_local_secret@localhost:5432/rentflow_db
# For Docker Compose: postgresql+asyncpg://postgres:postgres_local_secret@postgres:5432/rentflow_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_local_secret@localhost:5432/rentflow_db
DATABASE_ECHO=false

# CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Downstream AI Service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=10.0
