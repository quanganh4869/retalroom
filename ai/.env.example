# AI Service Configuration
APP_NAME=RentFlow AI Service
APP_ENV=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8001

# Provider setup: 'mock' (default, offline deterministic) or external API
AI_PROVIDER=mock

# External provider credentials (optional, only used when AI_PROVIDER is not mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_NAME=gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=15.0
