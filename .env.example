# RentFlow Root Environment Variables for Local Docker Compose Setup
# Copy this file to .env before running docker compose

COMPOSE_PROJECT_NAME=rentflow

# PostgreSQL Database Configuration
POSTGRES_DB=rentflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_secret
POSTGRES_PORT=5432

# Port allocations on host machine
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_PORT=8001
